import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np

# ==========================================
# 1. AESTHETICS & SETUP
# ==========================================
# Defining the requested Blue & Cream color palette
# Dark Navy, Medium Blue, Light Blue-Grey, Cream, Warm Beige
colors = ['#1A365D', '#4A90E2', '#8DB6CD', '#FDFBF7', '#E8E1D5']

# Set the background to the cream color for all plots
sns.set_theme(
    style="whitegrid", 
    rc={
        "axes.facecolor": "#FDFBF7", 
        "figure.facecolor": "#FDFBF7",
        "grid.color": "#E8E1D5",
        "font.family": "sans-serif"
    }
)
sns.set_palette(sns.color_palette(colors[:3])) # Using the blues for data elements

# Load the dataset
print("Loading dataset...")
df = pd.read_csv('dataviztechnical.csv')

# ==========================================
# 2. VISUALIZATION 1: THE CORRELATION HEATMAP
# ==========================================
print("Generating 1_Correlation_Heatmap.png...")
plt.figure(figsize=(10, 8))

# Select only numeric columns for correlation
numeric_cols = ['Age', 'Number of Dependents', 'Work Experience', 'Household Size', 'Annual Household Income']
corr_matrix = df[numeric_cols].corr()

# Create a custom colormap transitioning from cream to dark blue
cmap_blue_cream = sns.light_palette(colors[0], as_cmap=True)

sns.heatmap(
    corr_matrix, 
    annot=True, 
    fmt=".2f", 
    cmap=cmap_blue_cream, 
    linewidths=0.5, 
    linecolor='#FDFBF7',
    cbar_kws={'label': 'Correlation Coefficient'}
)

plt.title('The Drivers of Wealth: Feature Correlation', fontsize=16, fontweight='bold', color=colors[0], pad=20)
plt.tight_layout()
plt.savefig('1_Correlation_Heatmap.png', dpi=300)
plt.close()

# ==========================================
# 3. VISUALIZATION 2: DISTRIBUTION OF WEALTH (BOXPLOT)
# ==========================================
print("Generating 2_Income_Distribution.png...")
plt.figure(figsize=(12, 7))

# Ensure logical ordering of education levels
edu_order = ['High School', "Bachelor's", "Master's", "Doctorate"]

sns.boxplot(
    data=df, 
    x='Education Level', 
    y='Annual Household Income', 
    order=edu_order,
    palette=[colors[1], colors[1], colors[0], colors[0]], # Visual grouping
    linewidth=2,
    fliersize=4
)

plt.title('Income Ceilings by Educational Attainment', fontsize=16, fontweight='bold', color=colors[0], pad=20)
plt.xlabel('Highest Education Level', fontsize=12, fontweight='bold', color=colors[0])
plt.ylabel('Annual Household Income (USD)', fontsize=12, fontweight='bold', color=colors[0])

# Format y-axis to show thousands (e.g., $100k)
plt.gca().yaxis.set_major_formatter(plt.FuncFormatter(lambda x, loc: "${:,}k".format(int(x/1000))))

plt.tight_layout()
plt.savefig('2_Income_Distribution.png', dpi=300)
plt.close()

# ==========================================
# 4. VISUALIZATION 3: THE EXPERIENCE CURVE (SCATTER / LMLPLOT)
# ==========================================
print("Generating 3_Experience_Curve.png...")

# Using lmplot to show the scatter with a linear regression trend line
g = sns.lmplot(
    data=df, 
    x='Work Experience', 
    y='Annual Household Income', 
    hue='Gender',
    palette=[colors[0], colors[1]], 
    height=7, 
    aspect=1.5,
    scatter_kws={'alpha': 0.6, 'edgecolor': 'white', 'linewidth': 0.5},
    line_kws={'linewidth': 3}
)

g.fig.suptitle('Financial Return on Years of Work Experience', fontsize=16, fontweight='bold', color=colors[0], y=1.05)
g.set_axis_labels('Years of Work Experience', 'Annual Household Income (USD)', fontsize=12, fontweight='bold', color=colors[0])
g.ax.yaxis.set_major_formatter(plt.FuncFormatter(lambda x, loc: "${:,}k".format(int(x/1000))))

plt.savefig('3_Experience_Curve.png', dpi=300, bbox_inches='tight')
plt.close()

# ==========================================
# 5. VISUALIZATION 4: LIFESTYLE BREAKDOWN (GROUPED BAR CHART)
# ==========================================
print("Generating 4_Lifestyle_Breakdown.png...")
plt.figure(figsize=(12, 7))

# Calculate mean income grouped by transit and location
sns.barplot(
    data=df, 
    x='Primary Mode of Transportation', 
    y='Annual Household Income', 
    hue='Location',
    palette=[colors[0], colors[1], colors[2]],
    errorbar=None, # Removes error bars for cleaner presentation look
    edgecolor='#FDFBF7'
)

plt.title('Income Disparities by Commute and Geography', fontsize=16, fontweight='bold', color=colors[0], pad=20)
plt.xlabel('Primary Mode of Transportation', fontsize=12, fontweight='bold', color=colors[0])
plt.ylabel('Average Annual Household Income (USD)', fontsize=12, fontweight='bold', color=colors[0])
plt.legend(title='Location Type', title_fontsize='11', fontsize='10', frameon=True, facecolor='#FDFBF7', edgecolor=colors[0])

plt.gca().yaxis.set_major_formatter(plt.FuncFormatter(lambda x, loc: "${:,}k".format(int(x/1000))))

plt.tight_layout()
plt.savefig('4_Lifestyle_Breakdown.png', dpi=300)
plt.close()

print("All visualizations generated successfully! Check your folder for the PNG files.")