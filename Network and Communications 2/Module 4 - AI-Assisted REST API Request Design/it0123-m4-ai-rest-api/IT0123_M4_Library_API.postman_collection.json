            "type": "text/javascript",
            "exec": [
              "pm.test(\"R7b: status 401\", function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-KEY",
            "value": "invalid-key-for-r7"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "books"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 902,\n  \"title\": \"Packets Beneath the Acacia, Second Printing\",\n  \"author\": \"Lorna Villaverde\",\n  \"isbn\": \"978-0-000-00902-0\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "R7c Add book, key restored",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"R7c: status 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-KEY",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "books"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 902,\n  \"title\": \"Packets Beneath the Acacia, Second Printing\",\n  \"author\": \"Lorna Villaverde\",\n  \"isbn\": \"978-0-000-00902-0\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "R7d Cleanup: delete book 902",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"R7d: status 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-API-KEY",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/books/902",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "books",
            "902"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://library.demo.local"
    },
    {
      "key": "labUser",
      "value": ""
    },
    {
      "key": "labPass",
      "value": ""
    },
    {
      "key": "apiKey",
      "value": ""
    }
  ]
}